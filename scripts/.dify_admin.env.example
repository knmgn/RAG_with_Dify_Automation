# Credentials used by the Dify provisioning scripts (Phase 3 / Phase 4).
#
#   cp scripts/.dify_admin.env.example scripts/.dify_admin.env
#   # then fill in DIFY_PASSWORD
#
# scripts/.dify_admin.env is gitignored. Never commit the filled-in file.

# Dify console (Self-Hosted). Base URL is the nginx front door.
DIFY_BASE_URL=http://localhost
DIFY_EMAIL=admin@demo-logistics.local
DIFY_PASSWORD=

# Shared secret sent as the X-Auth-Token header from Dify to the n8n webhook.
# Must match the value stored in the n8n "Header Auth account" credential.
# Leave blank to let provision_chatflow.py read it out of the n8n container.
N8N_WEBHOOK_TOKEN=

# Workflow 1 (Intent Dispatcher) webhook path, without a leading slash.
N8N_INTENT_DISPATCHER_PATH=8ee2e0e7-1aa3-4c37-9444-47c34dd9d509
