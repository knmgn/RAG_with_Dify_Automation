# Slack bridge settings.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit the filled-in file.

# Bot User OAuth Token (OAuth & Permissions → Install to Workspace). Starts with xoxb-.
SLACK_BOT_TOKEN=
# App-level token with the connections:write scope (Basic Information →
# App-Level Tokens). Starts with xapp-. Required for Socket Mode.
SLACK_APP_TOKEN=

# Dify app API key (the app → API Access → API Key). Starts with app-.
DIFY_API_KEY=
# Dify Service API, reached over demo-rag-net. From outside Docker use
# http://localhost/v1 instead.
DIFY_API_BASE=http://api:5001/v1

# Channel ID (not name) where questions the policy does not cover are escalated
# to a human owner, e.g. C0123456789. Invite the bot to it. Leave empty to
# disable escalation; the bot still refuses, it just doesn't forward.
SLACK_ESCALATION_CHANNEL=

# Language of the bridge's own labels: en (default) or ja.
UI_LANGUAGE=en

# Phrase in the system prompt's fixed refusal. Change only if you change the prompt.
FALLBACK_MARKER=No explicit provision

# Optional
# DIFY_TIMEOUT_SECONDS=120
# BRIDGE_DB_PATH=/data/conversations.db
# LOG_LEVEL=INFO
